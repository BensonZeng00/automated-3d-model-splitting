{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Painted part visual semantics",
  "type": "object",
  "properties": {
    "parts": {
      "description": "P## part labels and optional visual evidence.",
      "oneOf": [
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/part"}},
        {"type": "array", "items": {"$ref": "#/$defs/part"}}
      ]
    },
    "physical_partitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/partition"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "properties": {
        "part": {"type": ["string", "integer"]},
        "part_id": {"type": ["string", "integer"]},
        "part_index": {"type": ["string", "integer"]},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "confidence": {"type": ["string", "number"]},
        "visual_evidence": {"type": "string"},
        "source_views": {"type": "array"}
      },
      "additionalProperties": true
    },
    "partition": {
      "type": "object",
      "properties": {
        "part": {"type": ["string", "integer"]},
        "part_index": {"type": ["string", "integer"]},
        "scope": {"enum": ["part", "all_components"]},
        "label": {"type": "string"},
        "origin": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
        "normal": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
        "confidence": {"type": ["string", "number"]},
        "user_confirmed": {"type": "boolean"},
        "source_views": {"type": "array"}
      },
      "additionalProperties": true
    }
  }
}
