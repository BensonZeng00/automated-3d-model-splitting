{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openai:skill:automated-3d-model-splitting:region-review:2.2.0",
  "title": "User-confirmed source-region semantic review",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "source_face_count",
    "noise_max_faces",
    "small_region_max_faces",
    "user_confirmed",
    "items"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "source": {"type": "string", "minLength": 1},
    "source_face_count": {"type": "integer", "minimum": 1},
    "noise_max_faces": {"type": "integer", "minimum": 0},
    "small_region_max_faces": {"type": "integer", "minimum": 0},
    "user_confirmed": {"const": true},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fragment_id",
          "source_min_face_index",
          "semantic_label",
          "visual_confidence",
          "classification"
        ],
        "properties": {
          "fragment_id": {"type": "integer", "minimum": 1},
          "source_min_face_index": {"type": "integer", "minimum": 0},
          "semantic_label": {"type": "string", "minLength": 1},
          "visual_confidence": {
            "oneOf": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"enum": ["VERYLOW", "LOW", "MED", "MEDIUM", "HIGH", "UNKNOWN"]}
            ]
          },
          "classification": {"enum": ["noise", "part", "uncertain"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
